# ============================================================
# NgomongAja — environment variables
# Copy this file to .env and fill in real values, then restart
# Expo (npx expo start -c) so changes are picked up.
#
# RULE: everything prefixed EXPO_PUBLIC_ is embedded in the app
# bundle and readable by anyone who has the APK. Only publishable
# keys belong here. NEVER put the Supabase SECRET key (sb_secret_...)
# in this file — it bypasses Row Level Security entirely.
# ============================================================

# --- Supabase (dashboard -> Project Settings -> API) ---
# Project URL (not secret)
EXPO_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Publishable key (safe in the client; RLS protects the data)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- AI voice pipeline ---
# NOTE: these are client-side only for the learning prototype.
# The production home is a Supabase Edge Function proxy (NFR-3),
# at which point they move out of this file entirely.

# Groq (https://console.groq.com/keys) — used for BOTH:
#   1. Whisper speech-to-text (whisper-large-v3-turbo)
#   2. LLM parsing fallback #2 (llama-3.3-70b-versatile)
EXPO_PUBLIC_GROQ_API="gsk_..."

# Google Gemini (https://aistudio.google.com/apikey) —
# primary order parser (gemini-2.5-flash-lite)
EXPO_PUBLIC_GEMINI_API="AIza..."

# OpenRouter (https://openrouter.ai/settings/keys) —
# LLM parsing fallback #3 (nvidia/nemotron-3-super-120b-a12b:free)
EXPO_PUBLIC_OPENROUTER_API="sk-or-v1-..."
