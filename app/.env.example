# Copy this file to .env and fill in real values from
# Supabase dashboard -> Project Settings -> API Keys.
# Only the PUBLISHABLE key goes here. The secret key must NEVER
# appear in this app -- it bypasses Row Level Security.
EXPO_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
